{
  "name": "@arkn/react-icon-picker",
  "description": "React Icon Picker",
  "version": "0.0.2",
  "private": false,
  "author": "Noé Gnanih <noegnanih@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "typings": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "dev-server": "pnpm --parallel vite",
    "dev-types": "tsc  --noEmit -p tsconfig.app.json --watch",
    "build": "pnpm build-lib && pnpm build-types",
    "build-lib": "vite build",
    "build-types": "rm -f *.tsbuildinfo && rm -rf types && tsc --emitDeclarationOnly --declaration -p tsconfig.app.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test-ci": "vitest --run",
    "version": "auto-changelog --template keepachangelog --hide-credit -p && git add CHANGELOG.md",
    "load-icon-assets": "tsx scripts/load-icon-assets.ts"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "lodash.uniqby": "^4.7.0",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sicons/antd": "^0.13.0",
    "@sicons/carbon": "^0.13.0",
    "@sicons/fa": "^0.13.0",
    "@sicons/fluent": "^0.13.0",
    "@sicons/ionicons4": "^0.13.0",
    "@sicons/ionicons5": "^0.13.0",
    "@sicons/material": "^0.13.0",
    "@sicons/tabler": "^0.13.0",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/node": "25.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.4",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "glob": "^13.0.1",
    "globals": "^17.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svgo": "^4.0.0",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeGnh/react-icon-picker.git"
  },
  "keywords": [
    "react",
    "icon",
    "picker",
    "icon-picker",
    "component",
    "ui",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/noeGnh/react-icon-picker/issues"
  },
  "homepage": "https://github.com/noeGnh/react-icon-picker#readme",
  "publishConfig": {
    "access": "public"
  }
}
